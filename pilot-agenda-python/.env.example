# No Railway/Render, DATABASE_URL é preenchida sozinha quando você
# adiciona um banco Postgres ao projeto — não precisa configurar isto
# manualmente lá. Isto aqui é só pra rodar local, se um dia instalar
# Python na sua máquina e quiser testar com Postgres em vez do SQLite
# padrão.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/agenda
